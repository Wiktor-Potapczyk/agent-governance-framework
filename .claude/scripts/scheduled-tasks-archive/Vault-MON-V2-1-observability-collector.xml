<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Nightly vault governance-metrics collector (MON-V2-1 R-1). Runs collect_vault_metrics.py for the prior day; appends to Resources/KB/vault-metrics-timeseries.jsonl.</Description>
    <URI>\Vault-MON-V2-1-observability-collector</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>REPLACE-WITH-YOUR-ACCOUNT-SID</UserId>
      <LogonType>InteractiveToken</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>true</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>true</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT10M</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <IdleSettings>
      <Duration>PT10M</Duration>
      <WaitTimeout>PT1H</WaitTimeout>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-05-22T10:00:00+02:00</StartBoundary>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Program Files\Python314\python.exe</Command>
      <Arguments>"C:\Users\WiktorPotapczyk\Desktop\Vault\.claude\scripts\collect_vault_metrics.py"</Arguments>
      <WorkingDirectory>C:\Users\WiktorPotapczyk\Desktop\Vault</WorkingDirectory>
    </Exec>
  </Actions>
</Task>