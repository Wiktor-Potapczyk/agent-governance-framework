<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>R-1V verifier: independent second-pass check on the daily metrics collector. Runs 30min after the collector. Spec: MON-V2-1 v1.</Description>
    <URI>\Vault-MON-V2-1-observability-verifier</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>REPLACE-WITH-YOUR-ACCOUNT-SID</UserId>
      <LogonType>InteractiveToken</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT10M</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <IdleSettings>
      <Duration>PT10M</Duration>
      <WaitTimeout>PT1H</WaitTimeout>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-05-23T10:30:00+02:00</StartBoundary>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Program Files\Python314\python.exe</Command>
      <Arguments>.claude\scripts\verify_vault_metrics.py</Arguments>
      <WorkingDirectory>C:\Users\WiktorPotapczyk\Desktop\Vault</WorkingDirectory>
    </Exec>
  </Actions>
</Task>