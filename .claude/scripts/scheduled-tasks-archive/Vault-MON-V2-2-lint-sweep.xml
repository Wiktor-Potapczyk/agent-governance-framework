<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>R-2 weekly vault wiki-citation lint sweep (CC-AUTOMATION-LEARN Step 3). Writes report to Resources/Observability/lint-sweeps/.</Description>
    <URI>\Vault-MON-V2-2-lint-sweep</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>REPLACE-WITH-YOUR-ACCOUNT-SID</UserId>
      <LogonType>InteractiveToken</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>true</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>true</StopIfGoingOnBatteries>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <IdleSettings>
      <Duration>PT10M</Duration>
      <WaitTimeout>PT1H</WaitTimeout>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
  </Settings>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-06-01T10:00:00+02:00</StartBoundary>
      <ScheduleByWeek>
        <WeeksInterval>1</WeeksInterval>
        <DaysOfWeek>
          <Sunday />
        </DaysOfWeek>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Program Files\Python314\python.exe</Command>
      <Arguments>"C:\Users\WiktorPotapczyk\Desktop\Vault\.claude\scripts\lint_sweep.py"</Arguments>
      <WorkingDirectory>C:\Users\WiktorPotapczyk\Desktop\Vault</WorkingDirectory>
    </Exec>
  </Actions>
</Task>